# Copy this file to .env and fill in your values

# ── MySQL (XAMPP) ─────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=greenhouse_db
DB_PORT=3306

# ── Server ────────────────────────────────────────────────────
PORT=5000

# ── CORS: comma-separated list of allowed React origins ───────
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ── ESP8266: set to ESP8266 local IP when hardware is ready ───
# ESP8266_BASE_URL=http://192.168.1.45
# ESP8266_TIMEOUT_MS=3000
